{
  "rewrites": [
    {
      "source": "/api/celestrak",
      "destination": "https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=TLE"
    }
  ],
  "headers": [
    {
      "source": "/api/celestrak",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=21600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
